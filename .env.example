# ---- Facebook / Meta ----
FB_VERIFY_TOKEN=make-up-any-random-string-and-paste-the-same-one-in-meta
FB_PAGE_ACCESS_TOKEN=EAAG...            # Page access token for Hotel The Grand Alayna
FB_APP_SECRET=...                        # Meta app > Settings > Basic > App Secret
FB_APP_ID=...                            # Meta app ID (so the bot ignores its own messages)

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
# BOT_MODEL=claude-opus-5                # default
# BOT_EFFORT=low                         # low | medium | high  (low = fastest + cheapest)

# ---- Supabase (server side only — NEVER the anon key, and never expose this) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- The off switch ----
BOT_SWITCH_KEY=make-up-a-long-random-string
# Then bookmark on your phone:
#   https://hotelthegrandalayna.com/.netlify/functions/bot-switch?key=THAT_STRING

# ---- Optional behaviour tuning ----
# BOT_DEBOUNCE_MS=4000                   # wait this long in case the guest is still typing
# BOT_MIN_TYPING_MS=1400
# BOT_MAX_TYPING_MS=5500
# BOT_MS_PER_CHAR=28                     # typing speed simulation
# BOT_HANDOFF_PAUSE_HOURS=8              # bot stays quiet this long after a staff reply
# BOT_SELF_HANDOFF_PAUSE_HOURS=1         # bot stays quiet this long after it asks for help
# BOT_HISTORY_TURNS=24                   # how much of the chat it remembers
# BOT_MAX_REPLIES_PER_CHAT=10            # after this many replies, hand the guest to a person
# BOT_PASS_TO_INBOX=false                # hand the thread to the Page Inbox on handoff
# BOT_STAFF_NOTIFY_URL=                  # POST handoff alerts to your own endpoint
# BOT_INTERNAL_SECRET=                   # optional; auto-derived from FB_APP_SECRET otherwise
